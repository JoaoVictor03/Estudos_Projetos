'Sub desenvolvida para poder cadastrar os clientes na baste
Public Sub Cadastrar_Cliente()
              'Dimensionar as variaveis
              Dim tabela As ListObject
              Dim Planilha As Worksheet
              Dim NovaLinha As ListRow
              Dim Novo_Id  As Long
              
              'Definir os objetos
              Set Planilha = Worksheets("Clientes")
              Set tabela = Planilha.ListObjects("tClientes")
'              Debug.Print (Tabela.Name)

              'Adicionar uma nova linha no objeto tabela.
              'Para isso, devemos usar listrows.add
              
              Set NovaLinha = tabela.ListRows.Add
              
              Novo_Id = WorksheetFunction.Max(tabela.ListColumns(1).DataBodyRange) + 1
              
              
              With NovaLinha
                     .Range(1) = Novo_Id
                     .Range(2) = txt_nome
                     .Range(3) = txt_idade
                     .Range(4) = txt_Email
                     .Range(5) = txt_telefone
                     .Range(6) = cb_Imovel.Value
             End With
             
             MsgBox "Cliente Cadastrado!", vbOKOnly, "Cadastrar novo Cliente"
             
             Call Carregar_Clientes_FUP
             
End Sub

